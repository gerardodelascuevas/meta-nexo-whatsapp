# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=reemplaza-por-un-token-elegido-por-ti
WHATSAPP_ACCESS_TOKEN=reemplaza-por-el-token-de-meta
WHATSAPP_PHONE_NUMBER_ID=reemplaza-por-el-phone-number-id
# Recomendado para validar que los POST realmente vienen de Meta
WHATSAPP_APP_SECRET=reemplaza-por-el-app-secret-de-meta
WHATSAPP_GRAPH_VERSION=v25.0

# ngrok
NGROK_AUTHTOKEN=reemplaza-por-el-token-de-ngrok

# Ollama
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# RAG
RAG_TOP_K=2
RAG_MIN_SIMILARITY=0.42
LOG_LEVEL=INFO
